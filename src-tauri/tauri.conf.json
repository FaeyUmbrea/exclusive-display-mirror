{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Exclusive Display Mirror",
  "version": "0.1.0",
  "identifier": "monster.void.exclusive-display-mirror",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Exclusive Display Mirror",
        "width": 1000,
        "height": 700,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/bootstrapper"
    ]
  }
}